# ─────────────────────────────────────────────────────────────────────────────
# Aira backend — environment. Every value degrades to a safe dev default when
# unset, so `uvicorn app:app --reload` runs with zero config. Production is
# locked down by setting ENV=production, which makes the startup checks in
# app.py fail closed on any missing secret.
# ─────────────────────────────────────────────────────────────────────────────

# The only LLM provider. Gemini runs the safety classifier AND the Aira reply.
# Calls that need it fail per-request (health stays up) when this is unset.
GEMINI_API_KEY=...

# Model knobs (defaults shown). The safety classifier deliberately runs on the
# same fast model as the reply; override to A/B a heavier one.
# AIRA_GEMINI_MODEL=gemini-2.5-flash
# AIRA_SAFETY_MODEL=gemini-2.5-flash
# AIRA_GEMINI_MAX_TOKENS=640

# ENV=production turns on Secure cookies and the fail-closed boot checks below.
# ENV=development

# --- App auth (mobile + web clients) ----------------------------------------
# If set, every /v1 data route requires header `X-App-Token: <secret>`
# (constant-time compared). Unset -> the coarse gate is a no-op (dev only). In
# production app.py refuses to boot without it.
# APP_SHARED_SECRET=

# Signs anonymous device tokens (POST /device/register) and account sessions.
# Falls back to a committed dev value; app.py rejects that default in prod.
# APP_SESSION_SECRET=dev-app-session-secret

# Sign in with Google (Android/web): the OAuth client id POST /account/google
# checks the ID token's `aud` claim against. No safe default — required in
# production, where an unset value fails closed with 503 rather than skipping
# the audience check.
# GOOGLE_CLIENT_ID=
# ANDROID_PACKAGE_NAME=com.aira.companion

# --- Admin console (browser) ------------------------------------------------
# Bootstrap the first owner on first run (idempotent — never clobbers an edit).
# ADMIN_BOOTSTRAP_EMAIL=you@example.com
# ADMIN_BOOTSTRAP_PASSWORD=change-me-long-random
# Signs admin session cookies. MUST be a long random value in production.
# ADMIN_JWT_SECRET=dev-admin-secret-change-me
# Comma-separated admin origins allowed by CORS (credentialed — no "*").
# ADMIN_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
# ADMIN_COOKIE_SAMESITE=strict
# ADMIN_COOKIE_DOMAIN=            # e.g. .aira.app when admin + api are subdomains

# --- Consumer web app (browser) ---------------------------------------------
# Origins allowed by CORS for the browser web client (apps/web). Separate from
# ADMIN_ORIGINS so the two clients' allow-lists are configured independently.
# Default covers the Vite dev server; set your deployed web URL(s) in production.
# WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Hardening knobs (all optional) -----------------------------------------
# MAX_UPLOAD_BYTES=20971520       # 20 MB — Care Vault document cap
# RATE_LIMIT_PER_MIN=120
# MAX_HISTORY_TURNS=20
# MAX_HISTORY_CHARS=2000
# TRUST_FORWARDED_FOR=1           # only behind a known proxy (Render/Fly)
# REDIS_URL=                      # multi-worker rate limiting

# --- Storage ----------------------------------------------------------------
# SQLite is the default (aira.db next to the app). Set DATABASE_URL to run on
# Postgres: postgresql://user:pass@host/db  (also `pip install 'psycopg[binary]'`).
# DATABASE_URL=
# SQLITE_PATH=

# --- Error tracking (optional) ----------------------------------------------
# SENTRY_DSN=
# SENTRY_TRACES_RATE=0
