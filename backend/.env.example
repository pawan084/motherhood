# Copy to backend/.env and fill in. Never commit the filled file.
#
# >>> Set hard monthly spend caps in BOTH vendor dashboards before using a live
# >>> key. A leaked key spends real money.

# ── Required ─────────────────────────────────────────────────────────────────
# Gemini: chat, the safety classifier, and multimodal audio turns.
GEMINI_API_KEY=
# ElevenLabs: text-to-speech.
ELEVENLABS_API_KEY=

# ── Models ───────────────────────────────────────────────────────────────────
# Gotcha inherited from sayli: a new key's Google Cloud project can have ZERO
# free quota on an entire model generation (429 with `limit: 0`). Probe a model
# before pinning it here.
# GEMINI_MODEL=gemini-2.5-flash
# The safety classifier is on the critical path of every turn — keep it fast.
# GEMINI_SAFETY_MODEL=gemini-2.5-flash-lite

# ── Environment ──────────────────────────────────────────────────────────────
# `production` activates the startup guard, which REFUSES to boot on any
# placeholder secret, a missing Gemini key, or a missing DATABASE_URL.
ENV=development

# ── Secrets (required in production) ──────────────────────────────────────────
# Generate each with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# APP_SESSION_SECRET=
# DEVICE_TOKEN_SECRET=      # falls back to APP_SESSION_SECRET when unset
# ADMIN_JWT_SECRET=

# ── Storage ──────────────────────────────────────────────────────────────────
# Postgres. Required in production: SQLite is single-instance and the file is
# ephemeral on most hosts. This database holds health data.
# DATABASE_URL=postgresql://user:pass@host/aira
# Without Redis, rate limiting and caches are per-worker.
# REDIS_URL=redis://localhost:6379/0
# Uploaded prescriptions/reports/scans. Local disk is a dev stand-in only —
# production needs object storage. This directory is PHI; it is gitignored.
# UPLOAD_DIR=

# ── Safety ───────────────────────────────────────────────────────────────────
# How long the LLM classifier gets before the gate gives up. On timeout the gate
# FAILS CLOSED and routes to Urgent Help — it never passes the message through.
# SAFETY_LLM_TIMEOUT_MS=4000

# ── Optional ─────────────────────────────────────────────────────────────────
# SENTRY_DSN=
