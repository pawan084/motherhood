# Aira web client — copy to .env and adjust. Vite only exposes VITE_* to the
# browser bundle, so never put a server secret in this file.

# Where the backend lives. Must match the host you browse the app on for the
# backend's CORS allow-list (WEB_ORIGINS) to accept it.
VITE_API_URL=http://127.0.0.1:8000

# The backend's coarse edge gate (its APP_SHARED_SECRET). Leave blank against a
# zero-config dev backend. REQUIRED in production, where app.py refuses to boot
# without APP_SHARED_SECRET and every route 401s without the header.
#
# NOTE: this value ships inside the browser bundle — it is a gate against
# casual traffic, not a secret. The real authorisation is the per-user session
# token minted by POST /device/register.
# VITE_APP_TOKEN=
