<?xml version="1.0" encoding="utf-8"?>
<!--
  The splash icon: a static vector of the brand orb.

  It cannot reuse ui/components/BrandOrb — that draws on a Compose Canvas, and the
  splash window exists before any Compose content does. The concentric structure is
  kept the same (lilac field, offset sage bloom, plum core, paper highlight) so the
  splash and the in-app orb read as one mark.

  Drawn on a 108dp canvas with the art inset to ~2/3, which is what the Android 12
  splash spec expects for a non-adaptive icon — art any larger gets clipped by the
  system's circular mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer field. Centre is 54,54 — the canvas centre. An earlier draft had
         54,18, which pushed the circle up until the system's circular splash mask
         sliced the top off and left a pointed silhouette. -->
    <path
        android:fillColor="#EFE4F1"
        android:pathData="M54,54 m-36,0 a36,36 0 1,0 72,0 a36,36 0 1,0 -72,0" />

    <!-- Inner field, slightly deeper so the orb has depth rather than reading flat -->
    <path
        android:fillColor="#E9DDEA"
        android:pathData="M54,54 m-29,0 a29,29 0 1,0 58,0 a29,29 0 1,0 -58,0" />

    <!-- Sage bloom, offset up and right to match BrandOrb -->
    <path
        android:fillColor="#8FA58E"
        android:fillAlpha="0.34"
        android:pathData="M56.9,52.6 m-21.2,0 a21.2,21.2 0 1,0 42.4,0 a21.2,21.2 0 1,0 -42.4,0" />

    <!-- Plum core -->
    <path
        android:fillColor="#4A234B"
        android:fillAlpha="0.88"
        android:pathData="M54,54 m-10.4,0 a10.4,10.4 0 1,0 20.8,0 a10.4,10.4 0 1,0 -20.8,0" />

    <!-- Paper highlight -->
    <path
        android:fillColor="#FFFCF8"
        android:pathData="M54,54 m-3.6,0 a3.6,3.6 0 1,0 7.2,0 a3.6,3.6 0 1,0 -7.2,0" />
</vector>
