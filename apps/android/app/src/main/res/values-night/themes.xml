<resources>
    <!-- Same structure as the light theme; only the light-icon flags differ.
         Dark surfaces need light status-bar icons, or the clock vanishes. -->
    <style name="Theme.Aira" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/aira_ivory</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
