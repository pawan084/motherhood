<?xml version="1.0" encoding="utf-8"?>
<!--
  The splash orb, for a dark launch window.

  Same geometry as drawable/ic_splash_orb.xml — see that file for why the centre
  is 54,54 — with the fields darkened and the core lifted. Reusing the light
  version would have put a near-white disc on a #17141A window: legible, but a
  glare at exactly the moment a dark-mode user opened the app to avoid one, and
  at the hour this app is most often opened.

  The plum core inverts with the palette: on ivory the core is the darkest part
  of the mark, on charcoal it has to be the lightest, or the orb reads as a hole.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer field -->
    <path
        android:fillColor="#2E2536"
        android:pathData="M54,54 m-36,0 a36,36 0 1,0 72,0 a36,36 0 1,0 -72,0" />

    <!-- Inner field, slightly deeper so the orb has depth rather than reading flat -->
    <path
        android:fillColor="#3A2F42"
        android:pathData="M54,54 m-29,0 a29,29 0 1,0 58,0 a29,29 0 1,0 -58,0" />

    <!-- Sage bloom, offset up and right to match BrandOrb -->
    <path
        android:fillColor="#9DB79C"
        android:fillAlpha="0.30"
        android:pathData="M56.9,52.6 m-21.2,0 a21.2,21.2 0 1,0 42.4,0 a21.2,21.2 0 1,0 -42.4,0" />

    <!-- Plum core, lifted to read as the brightest part of the mark -->
    <path
        android:fillColor="#D9BCE0"
        android:fillAlpha="0.92"
        android:pathData="M54,54 m-10.4,0 a10.4,10.4 0 1,0 20.8,0 a10.4,10.4 0 1,0 -20.8,0" />

    <!-- Highlight -->
    <path
        android:fillColor="#FFFCF8"
        android:pathData="M54,54 m-3.6,0 a3.6,3.6 0 1,0 7.2,0 a3.6,3.6 0 1,0 -7.2,0" />
</vector>
