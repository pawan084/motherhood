<resources>
    <!--
      The theme the window actually launches with. Everything drawn before Compose
      exists comes from here, so first launch shows the brand rather than a blank
      flash. `postSplashScreenTheme` hands over to Theme.Aira once content is ready;
      MainActivity holds the splash a little longer while the cached session
      resolves — see setKeepOnScreenCondition.
    -->
    <style name="Theme.Aira.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/aira_ivory</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_orb</item>
        <item name="postSplashScreenTheme">@style/Theme.Aira</item>
    </style>

    <style name="Theme.Aira" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/aira_ivory</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
