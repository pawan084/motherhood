<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Aira">

        <!--
          android:enableOnBackInvokedCallback above turns on predictive back: the
          system draws the destination behind the back gesture, so a partial
          swipe shows where it leads and can be released to cancel. It only does
          anything because the app now registers BackHandlers to preview —
          before those, the gesture had nothing to show but the home screen.
        -->

        <!--
          Android 16 ignores an activity's orientation lock on displays of 600dp
          or wider for apps targeting SDK 36, so `screenOrientation="portrait"`
          alone holds on phones but not on tablets or unfolded foldables. This
          opts back in to the restriction.

          Google documents it as TEMPORARY — it will stop working in a later
          release. The durable answer is responsive layouts; every screen here is
          currently designed portrait-only, so honouring the lock is the truthful
          state today. Revisit when large screens are actually supported.
        -->
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Aira.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The Done and Snooze buttons on a reminder. Not exported: nothing
             outside this app has any business marking someone's reminders
             done. -->
        <receiver
            android:name=".reminders.ReminderActionReceiver"
            android:exported="false" />

        <!-- Hands a downloaded document to a viewer as a content:// URI with a
             one-shot read grant, so opening a scan never exports the file or
             makes it readable by anything that didn't receive the grant. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
