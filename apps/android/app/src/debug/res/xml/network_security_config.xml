<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILDS ONLY (src/debug) — release builds never see this file, so they
  keep Android's default "no cleartext, anywhere".

  Since targetSdk 28, cleartext HTTP is blocked by default. Without this the
  documented dev backend (http://10.0.2.2:8000, the host loopback as seen from
  the emulator) fails with CleartextNotPermittedException before a request is
  ever sent. Each host below is a local development target only:

    10.0.2.2   the host machine, from the standard Android emulator
    10.0.3.2   the same, from Genymotion
    127.0.0.1  the device itself, when using `adb reverse tcp:8000 tcp:8000`
    localhost  ditto

  A LAN IP for a physical device is deliberately NOT listed — add yours here
  temporarily if you need it, or prefer `adb reverse`, which needs no change.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
