# Point the admin at your Aira backend (the FastAPI host serving /admin/*).
# Use the SAME host you browse the admin on (127.0.0.1 vs localhost are
# different sites for a SameSite=Strict session cookie — mixing them loops login).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Dev-only: prefill the login form so you don't retype the bootstrap credentials.
# Ship blank in production builds.
# NEXT_PUBLIC_DEV_ADMIN_EMAIL=you@example.com
# NEXT_PUBLIC_DEV_ADMIN_PASSWORD=
